<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mipa.mapper.ReaderBookShelfMapper">

    <resultMap id="ReaderBookShelfResultMap" type="com.mipa.model.ReaderBookShelf">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="bookId" column="book_id"/>
        <result property="chapterId" column="chapter_id"/>
        <result property="chapterOrder" column="chapter_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="ReaderBookShelfWithCoverResultMap" type="com.mipa.common.vo.BookShelfVO">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="bookId" column="book_id"/>
        <result property="chapterId" column="chapter_id"/>
        <result property="chapterOrder" column="chapter_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="coverUrl" column="cover_url"/>
    </resultMap>

    <select id="selectById" resultMap="ReaderBookShelfResultMap" parameterType="String">
        SELECT * FROM reader_bookshelf WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="ReaderBookShelfResultMap">
        SELECT * FROM reader_bookshelf
    </select>

    <select id="selectByUserIdAndBookId" resultMap="ReaderBookShelfResultMap" parameterType="String">
        SELECT * FROM reader_bookshelf
        WHERE user_id = #{userId} AND book_id = #{bookId}
    </select>
    <select id="selectByUserId" resultMap="ReaderBookShelfResultMap" parameterType="String">
        SELECT * FROM reader_bookshelf
        WHERE user_id = #{userId}
    </select>

    <select id="selectDetailAndCoverByUserIdAndBookId" resultMap="ReaderBookShelfWithCoverResultMap" parameterType="map">
        SELECT
            rb.*,
            b.cover_url
        FROM reader_bookshelf rb
        LEFT JOIN book b ON rb.book_id = b.id
        WHERE rb.user_id = #{userId} AND rb.book_id = #{bookId}
    </select>

    <insert id="insert" parameterType="com.mipa.model.ReaderBookShelf">
        INSERT INTO reader_bookshelf (id, user_id, book_id, chapter_id, chapter_order)
        VALUES (#{id}, #{userId}, #{bookId}, #{chapterId}, #{chapterOrder})
    </insert>

    <update id="update" parameterType="com.mipa.model.ReaderBookShelf">
        UPDATE reader_bookshelf
        SET user_id = #{userId},
        book_id = #{bookId},
        chapter_id = #{chapterId},
        chapter_order = #{chapterOrder}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="String">
        DELETE FROM reader_bookshelf WHERE id = #{id}
    </delete>

    <delete id="deleteByUserIdAndBookId" parameterType="map">
        DELETE FROM reader_bookshelf
        WHERE user_id = #{userId} AND book_id = #{bookId}
    </delete>

</mapper>