<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mipa.mapper.ChapterContentPageMapper">
    <resultMap id="ContentPageResultMap" type="com.mipa.model.ChapterContentPage">
        <id property="id" column="id"/>
        <result property="data" column="data"/>
        <result property="chapterId" column="chapter_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectById" resultMap="ContentPageResultMap" parameterType="string">
        SELECT * FROM chapter_content_page
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="ContentPageResultMap">
        SELECT * FROM chapter_content_page
    </select>

    <insert id="insert" parameterType="com.mipa.model.ChapterContentPage">
        INSERT INTO chapter_content_page(id,  chapter_id, data)
        VALUES (#{id}, #{chapterId}, #{data})
    </insert>

    <insert id="insertBatch" parameterType="list">
        INSERT INTO chapter_content_page(id, chapter_id, data)
        VALUES
        <foreach collection="pages" item="page" separator=",">
            (#{page.id}, #{page.chapterId}, #{page.data})
        </foreach>

    </insert>

    <update id="update" parameterType="com.mipa.model.ChapterContentPage">
        UPDATE chapter_content_page
        SET chapter_id = #{chapterId},
        data = #{data}
        WHERE id = #{id}
    </update>

    <update id="updateBatch" parameterType="list">
        <foreach collection="pages" item="page" separator=";">
            UPDATE chapter_content_page
            SET chapter_id = #{page.chapterId},
            data = #{page.data}
            WHERE id = #{page.id}
        </foreach>
    </update>

    <delete id="delete" parameterType="string">
        DELETE FROM chapter_content_page
        WHERE id = #{id}
    </delete>
    <delete id="deleteBatch" parameterType="list">
        DELETE FROM chapter_content_page
        WHERE id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>