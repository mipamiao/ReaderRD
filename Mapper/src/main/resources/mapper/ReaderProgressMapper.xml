<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mipa.mapper.ReaderProgressMapper">

    <resultMap id="ReaderProgressResultMap" type="com.mipa.model.ReaderProgress">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="bookId" column="book_id"/>
        <result property="chapterId" column="chapter_id"/>
        <result property="chapterOrder" column="chapter_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectById" resultMap="ReaderProgressResultMap" parameterType="String">
        SELECT * FROM reader_progress WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="ReaderProgressResultMap">
        SELECT * FROM reader_progress
    </select>

    <insert id="insert" parameterType="com.mipa.model.ReaderProgress">
        INSERT INTO reader_progress (id, user_id, book_id, chapter_id, chapter_order)
        VALUES (#{id}, #{userId}, #{bookId}, #{chapterId}, #{chapterOrder})
    </insert>

    <update id="update" parameterType="com.mipa.model.ReaderProgress">
        UPDATE reader_progress
        SET user_id = #{userId},
        book_id = #{bookId},
        chapter_id = #{chapterId},
        chapter_order = #{chapterOrder},
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="String">
        DELETE FROM reader_progress WHERE id = #{id}
    </delete>

</mapper>
