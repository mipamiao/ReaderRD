<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mipa.mapper.TagMapper">

    <resultMap id="TagResultMap" type="com.mipa.model.Tag">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectById" resultMap="TagResultMap" parameterType="String">
        SELECT * FROM tags WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="TagResultMap">
        SELECT * FROM tags
    </select>

    <insert id="insert" parameterType="com.mipa.model.Tag">
        INSERT INTO tags (id, name)
        VALUES (#{id}, #{name})
    </insert>

    <update id="update" parameterType="com.mipa.model.Tag">
        UPDATE tags
        SET name = #{name},
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="String">
        DELETE FROM tags WHERE id = #{id}
    </delete>

</mapper>
