<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mipa.mapper.BookTagMapper">

    <resultMap id="BookTagResultMap" type="com.mipa.model.BookTag">
        <id property="id" column="id"/>
        <result property="bookId" column="book_id"/>
        <result property="tagId" column="tag_id"/>
    </resultMap>

    <resultMap id="BookWithTagsResultMap" type="com.mipa.common.vo.BookWithTagsVO">
        <id property="id" column="book_id"/>

        <collection property="tagNames" ofType="string">
            <result column="tag_name"/>
        </collection>
    </resultMap>

    <select id="selectById" resultMap="BookTagResultMap" parameterType="String">
        SELECT * FROM book_tag WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BookTagResultMap">
        SELECT * FROM book_tag
    </select>

    <insert id="insert" parameterType="com.mipa.model.BookTag">
        INSERT INTO book_tag (id, book_id, tag_id)
        VALUES (#{id}, #{bookId}, #{tagId})
    </insert>

    <update id="update" parameterType="com.mipa.model.BookTag">
        UPDATE book_tag
        SET book_id = #{bookId},
        tag_id = #{tagId}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="String">
        DELETE FROM book_tag WHERE id = #{id}
    </delete>

    <delete id="deleteByBookId" parameterType="String" >
        DELETE FROM book_tag WHERE book_id = #{bookId}
    </delete>

    <insert id="insertBatch" parameterType="list">
        INSERT INTO book_tag (id, book_id, tag_id)
        VALUES
        <foreach collection="bookTags" item="bookTag" separator=",">
            (#{bookTag.id}, #{bookTag.bookId}, #{bookTag.tagId})
        </foreach>
    </insert>

    <select id="selectBookAndTagsByBookIds" resultMap="BookWithTagsResultMap" parameterType="list">
        SELECT
        bt.book_id ,
        t.name as tag_name
        FROM book_tag bt
        LEFT JOIN tag t ON bt.tag_id = t.id
        WHERE bt.book_id in
        <foreach collection="bookIds" open="(" separator="," close=")" item="bookId">
            #{bookId}
        </foreach>
    </select>



</mapper>
